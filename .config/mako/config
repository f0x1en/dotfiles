# Campbell
font=JetBrainsMono Nerd Font 10
anchor=top-right
width=360
height=150
outer-margin=12
margin=6
padding=14
border-size=2
border-radius=6
icons=1
max-icon-size=40

background-color=#0C0C0Cf2
text-color=#B8B8B8
border-color=#2A2A2A
progress-color=over #242424

default-timeout=5000
ignore-timeout=1
max-visible=5
history=1
max-history=100

[urgency=low]
border-color=#242424
text-color=#6B6B6B

[urgency=critical]
border-color=#CC5F5A
default-timeout=0

[mode=do-not-disturb]
invisible=1
