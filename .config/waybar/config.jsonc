{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "margin-bottom": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "tray",
        "backlight",
        "pulseaudio",
        "pulseaudio#mic",
        "sway/language",
        "custom/date",
        "clock"
    ],
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
        }
    },
    "backlight": {
        "format": "<span color='#6B6B6B'>󰃟</span> {percent}%",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "<span color='#6B6B6B'>{icon}</span> {volume}%",
        "format-muted": "<span color='#CC5F5A'>󰝟</span> <span color='#CC5F5A'>muted</span>",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "kitty --title wiremix wiremix",
        "tooltip": false
    },
    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-source": "<span color='#6B6B6B'>󰍬</span> {volume}%",
        "format-source-muted": "<span color='#CC5F5A'>󰍭</span> <span color='#CC5F5A'>off</span>",
        "on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
        "tooltip": false
    },
    "sway/language": {
        "format": "<span color='#6B6B6B'>󰌌</span> {shortDescription}",
        "min-length": 2,
        "tooltip": false
    },
    "custom/date": {
        "exec": "~/.config/waybar/jalali-date",
        "interval": 30,
        "tooltip": false
    },
    "clock": {
        "interval": 1,
        "format": "{:%I:%M:%S %p}",
        "tooltip": false
    }
}
