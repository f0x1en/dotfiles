{
    "layer": "top",
    "position": "bottom",
    "height": 24,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "backlight",
        "pulseaudio",
        "sway/language",
        "custom/date",
        "clock",
        "tray"
    ],
    "tray": {
        "icon-size": 16,
        "spacing": 6
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
        }
    },
    "sway/language": {
        "format": "{shortDescription}",
        "min-length": 2,
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{icon} {volume}%  {format_source}",
        "format-muted": "󰝟 muted  {format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭 off",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
        "tooltip": false
    },
    "backlight": {
        "format": "󰃟 {percent}%",
        "tooltip": false
    },
    "custom/date": {
        "exec": "~/.config/waybar/jalali-date",
        "interval": 30,
        "tooltip": false
    },
    "clock": {
        "interval": 1,
        "format": "{:%I:%M:%S %p}",
        "tooltip": false
    }
}
