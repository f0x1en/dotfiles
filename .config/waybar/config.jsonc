{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "margin-bottom": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "tray",
        "backlight",
        "pulseaudio",
        "pulseaudio#mic",
        "battery",
        "sway/language",
        "clock#date",
        "clock"
    ],
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name} {windows}",
        "format-window-separator": " ",
        "window-rewrite-default": "\uf2d0",
        "window-rewrite": {
            "class<peek-hold>": "",
            "class<kitty>": "\ue795",
            "class<org.telegram.desktop>": "\uf2c6",
            "class<firefox.*>": "\uf269",
            "class<[Cc]hromium.*>": "\uf268",
            "class<obsidian>": "\uf02d",
            "class<[Ss]potify>": "\uf1bc",
            "class<mpv>": "\uf03d"
        }
    },
    "battery": {
        "states": { "critical": 15 },
        "format": "<span color='#6B6B6B'>{icon}</span> {capacity}%",
        "format-charging": "<span color='#6B6B6B'>\uf0e7</span> {capacity}%",
        "format-plugged": "<span color='#6B6B6B'>\uf1e6</span> {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "tooltip-format": "{timeTo}"
    },
    "backlight": {
        "format": "<span color='#6B6B6B'>󰃟</span> {percent}%",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "<span color='#6B6B6B'>{icon}</span> {volume}%",
        "format-muted": "<span color='#CC5F5A'>󰝟</span> <span color='#CC5F5A'>muted</span>",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "kitty --title wiremix wiremix",
        "tooltip": false
    },
    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-source": "<span color='#6B6B6B'>󰍬</span> {volume}%",
        "format-source-muted": "<span color='#CC5F5A'>󰍭</span> <span color='#CC5F5A'>off</span>",
        "on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
        "tooltip": false
    },
    "sway/language": {
        "format": "<span color='#6B6B6B'>󰌌</span> {shortDescription}",
        "min-length": 2,
        "tooltip": false
    },
    "clock#date": {
        "format": "{:%a %d %b}",
        "tooltip": false
    },
    "clock": {
        "interval": 1,
        "format": "{:%I:%M:%S %p}",
        "tooltip": false
    }
}
