{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "margin-bottom": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "tray",
        "network",
        "bluetooth",
        "custom/proxy",
        "pulseaudio",
        "pulseaudio#mic",
        "backlight",
        "battery",
        "sway/language",
        "clock#date",
        "clock"
    ],
    "network": {
        "interface": "wlp*",
        "format-wifi": "<span color='#6B6B6B' size='large'>{icon}</span> {essid}",
        "format-icons": [
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "format-ethernet": "<span color='#6B6B6B' size='large'></span> wired",
        "format-disconnected": "<span color='#CC5F5A' size='large'>󰤮</span> <span color='#CC5F5A'>offline</span>",
        "format-disabled": "<span color='#5A5A5A' size='large'>󰤮</span> off",
        "tooltip-format-wifi": "{essid}  {signalStrength}%  {frequency} GHz\n{ipaddr}/{cidr} via {gwaddr}\nclick: Wi-Fi menu  right-click: Wi-Fi on/off",
        "tooltip-format-disconnected": "offline\nclick: Wi-Fi menu  right-click: Wi-Fi on/off",
        "max-length": 24,
        "on-click": "~/.config/sway/scripts/tui-toggle wlctl wlctl",
        "on-click-right": "sh -c '[ \"$(nmcli radio wifi)\" = enabled ] && nmcli radio wifi off || nmcli radio wifi on'"
    },
    "bluetooth": {
        "format": "<span color='#6B6B6B' size='large'>󰂯</span>",
        "format-off": "<span color='#5A5A5A' size='large'>󰂲</span>",
        "format-disabled": "<span color='#5A5A5A' size='large'>󰂲</span>",
        "format-connected": "<span color='#6B6B6B' size='large'>󰂱</span> {device_alias}",
        "format-connected-battery": "<span color='#6B6B6B' size='large'>󰂱</span> {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}: {status}\nclick: Bluetooth menu  right-click: on/off",
        "tooltip-format-connected": "{device_enumerate}\nclick: Bluetooth menu  right-click: on/off",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
        "max-length": 24,
        "on-click": "~/.config/sway/scripts/tui-toggle bluetui bluetui",
        "on-click-right": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && bluetoothctl power off || bluetoothctl power on'"
    },
    "custom/proxy": {
        "exec": "~/.config/waybar/scripts/proxy-status",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "on-click": "~/.config/sway/scripts/tui-toggle bushuray bushuray",
        "on-click-right": "~/.local/bin/proxy retry >/dev/null 2>&1; pkill -RTMIN+8 waybar"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name} <span size='large'>{windows}</span>",
        "format-window-separator": " ",
        "window-rewrite-default": "",
        "window-rewrite": {
            "class<peek-hold>": "",
            "class<kitty>": "",
            "class<org.telegram.desktop>": "",
            "class<firefox.*>": "",
            "class<[Cc]hromium.*>": "",
            "class<obsidian>": "",
            "class<[Ss]potify>": "",
            "class<mpv>": ""
        }
    },
    "battery": {
        "states": {
            "critical": 15
        },
        "format": "<span color='#6B6B6B' size='large'>{icon}</span> {capacity}%",
        "format-charging": "<span color='#6B6B6B' size='large'></span> {capacity}%",
        "format-plugged": "<span color='#6B6B6B' size='large'></span> {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "tooltip-format": "{timeTo}"
    },
    "backlight": {
        "format": "<span color='#6B6B6B' size='large'>󰃟</span> {percent}%",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "<span color='#6B6B6B' size='large'>{icon}</span> {volume}%",
        "format-muted": "<span color='#CC5F5A' size='large'>󰝟</span> <span color='#CC5F5A'>muted</span>",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "kitty --title wiremix wiremix",
        "tooltip": false
    },
    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-source": "<span color='#6B6B6B' size='large'>󰍬</span> {volume}%",
        "format-source-muted": "<span color='#CC5F5A' size='large'>󰍭</span> <span color='#CC5F5A'>off</span>",
        "on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
        "tooltip": false
    },
    "sway/language": {
        "format": "<span color='#6B6B6B' size='large'>󰌌</span> {shortDescription}",
        "min-length": 2,
        "tooltip": false
    },
    "clock#date": {
        "format": "{:%a %d %b}",
        "tooltip": false
    },
    "clock": {
        "interval": 1,
        "format": "{:%I:%M:%S %p}",
        "tooltip": false
    }
}
