{
    "layer": "top",
    "position": "bottom",
    "height": 24,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "custom/keyboard",
        "clock",
        "tray"
    ],
    "tray": {
        "icon-size": 16,
        "spacing": 6
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
        }
    },
    "custom/keyboard": {
        "exec": "swaymsg -t get_inputs | jq -r '[.[] | select(.type == \"keyboard\") | .xkb_active_layout_name][0] | if startswith(\"English\") then \"EN\" elif startswith(\"Persian\") then \"FA\" else . end'",
        "interval": 1,
        "format": "{}",
        "tooltip": false
    },
    "clock": {
        "interval": 1,
        "format": "{:%H:%M:%S}",
        "tooltip": false
    }
}
