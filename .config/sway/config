### Variables

set $mod Mod4
set $term kitty
set $menu fuzzel
set $browser firefox-esr

### Appearance
# Palette: Campbell (neutral UI, color only for state)
#   bg #0C0C0C  surface #242424  border #2A2A2A  dim #6B6B6B  fg #B8B8B8  bright #D4D4D4
#   focus #6B6B6B  (state colors only: red #CC5F5A  yellow #C99A45  green #6FA05A)

font pango:JetBrainsMono Nerd Font 10

# Slightly lighter than the windows so the gaps read as depth
output * bg #141414 solid_color
seat * xcursor_theme Adwaita 24
exec_always ~/.config/sway/scripts/gtk-theme

# Gaps and thin borders, no title bars
gaps inner 8
gaps outer 4
default_border pixel 2
default_floating_border pixel 2

#                        border  background text    indicator child_border
client.focused           #707070 #0C0C0C   #D4D4D4 #707070   #707070
client.focused_inactive  #2A2A2A #0C0C0C   #6B6B6B #2A2A2A   #2A2A2A
client.unfocused         #242424 #0C0C0C   #6B6B6B #242424   #242424
client.urgent            #CC5F5A #0C0C0C   #D4D4D4 #CC5F5A   #CC5F5A
client.placeholder       #0C0C0C #0C0C0C   #6B6B6B #0C0C0C   #0C0C0C
client.background        #141414

### Startup

# Declare environment
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
# Monitor
exec_always sh -c 'pkill -x kanshi 2>/dev/null; exec kanshi'
# status bar
exec_always sh -c 'pkill -x waybar 2>/dev/null; exec waybar'
# toggle status bar (waybar hides on SIGUSR1)
bindsym $mod+Ctrl+b exec pkill -SIGUSR1 -x waybar
# Notifications
exec mako
# Volume/brightness OSD
exec_always ~/.config/sway/scripts/wob-start
# Auth prompts (polkit agent) and USB automount: Plasma used to do both
exec lxpolkit
# Load the SSH key into the systemd agent once per login (passphrase via zenity)
exec sh -c 'SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/openssh_agent" SSH_ASKPASS="$HOME/.config/sway/scripts/ssh-askpass" SSH_ASKPASS_REQUIRE=force ssh-add'
exec udiskie --no-tray
# kdeconnect phone
exec /usr/bin/kdeconnectd
# Clipboard
exec wl-paste --watch cliphist store
# Idle: lock after 10 min, screen off after 15, lock before suspend
exec swayidle -w \
    timeout 600 'swaylock -f' \
    timeout 900 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'
# v2rayn
# assign [class="v2rayN"] workspace number 9
# exec /usr/bin/v2rayn

### Key bindings

# Screen lock
bindsym $mod+Escape exec swaylock
# Run command
bindsym $mod+x exec ~/.config/sway/scripts/run-command
# Power menu
bindsym $mod+Shift+p exec ~/.config/sway/scripts/power-menu
# Help menu
bindsym $mod+slash exec kitty --title sway-help ~/.config/sway/scripts/help-menu
# Terminal
bindsym $mod+Return exec $term
# Browser
bindsym $mod+w exec $browser
# Launcher
bindsym $mod+d exec $menu
# Kill window
bindsym $mod+Shift+q kill
# Reload Sway
bindsym $mod+Shift+c reload
# Exit Sway
bindsym $mod+Shift+e exec swaymsg exit
# Network
bindsym $mod+Shift+n exec kitty --title wlctl wlctl
# Bluetooth
bindsym $mod+Shift+b exec kitty --title bluetui bluetui
# Audio
bindsym $mod+Shift+a exec kitty --title wiremix wiremix --tab playback
# Music: mod+m shows or hides the player (it keeps playing); mod+F7/F8/F9 prev, pause, next
bindsym $mod+m exec ~/.config/sway/scripts/music-toggle
bindsym $mod+F7 exec ~/.local/bin/music prev
bindsym $mod+F8 exec ~/.local/bin/music pause
bindsym $mod+F9 exec ~/.local/bin/music next
# Clipboard
bindsym $mod+c exec cliphist list | fuzzel --dmenu --with-nth 2 | cliphist decode | wl-copy
# Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
# Move windows
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
# Hardware controls
bindsym $mod+F1 exec ~/.config/sway/scripts/osd vol-mute
bindsym $mod+F2 exec ~/.config/sway/scripts/osd vol-down
bindsym $mod+F3 exec ~/.config/sway/scripts/osd vol-up
bindsym $mod+F4 exec ~/.config/sway/scripts/osd mic-mute
bindsym $mod+F5 exec ~/.config/sway/scripts/osd bright-down
bindsym $mod+F6 exec ~/.config/sway/scripts/osd bright-up
## yazi
bindsym $mod+e exec kitty --title files yazi
## music: use mpv directly for now
# change keyboard layout
input type:keyboard {
    xkb_layout "us,ir"
    xkb_options "grp:win_space_toggle"
}
# Screenshot selected region and copy it to clipboard
bindsym $mod+Print exec grim -g "$(slurp)" - | wl-copy
# Screenshot full screen / selected region to ~/Pictures/screenshots
bindsym $mod+Shift+Print exec sh -c 'mkdir -p ~/Pictures/screenshots && f=~/Pictures/screenshots/$(date +%F_%H-%M-%S).png && grim "$f" && notify-send -t 2000 Screenshot "$f"'
bindsym $mod+Ctrl+Print exec sh -c 'mkdir -p ~/Pictures/screenshots && f=~/Pictures/screenshots/$(date +%F_%H-%M-%S).png && grim -g "$(slurp)" "$f" && notify-send -t 2000 Screenshot "$f"'
## tele
bindsym $mod+t exec kitty --title tele tele

### Workspaces

# Switch
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
# Move window to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
# Resize windows directly
bindsym $mod+Ctrl+h resize grow width 10 px
bindsym $mod+Ctrl+j resize shrink height 10 px
bindsym $mod+Ctrl+k resize grow height 10 px
bindsym $mod+Ctrl+l resize shrink width 10 px

### Layout

# Disable focus on mouse hover
focus_follows_mouse no
# Default split direction
default_orientation horizontal
# Split direction
bindsym $mod+b splitv
bindsym $mod+v splith
# Fullscreen
bindsym $mod+f fullscreen
# Floating
bindsym $mod+Shift+space floating toggle

### Mouse

# Move floating windows
floating_modifier $mod
# Make floating
for_window [title="^wlctl$"] floating enable, resize set width 900px height 600px
for_window [title="^bluetui$"] floating enable, resize set width 900px height 600px
for_window [title="^wiremix$"] floating enable, resize set width 900px height 600px
for_window [title="^music$"] move scratchpad, scratchpad show, resize set width 90 ppt height 85 ppt, move position center
for_window [title="^sway-help$"] floating enable, resize set width 760px height 620px, move position center

### XWayland
xwayland enable
