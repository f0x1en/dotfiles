#!/bin/sh
# Usage: peek N | peek up | peek down
# peek N (mod+Ctrl+N): float the last-focused window of workspace N over the
# current workspace, see-through, and focus it.
# Same key again, mod+<current workspace>, any mod+Ctrl+N, or switching
# workspace sends it back.
# peek go N (mod+N): on workspace N, send back the peeking window; else switch to N.
# The window carries a hidden mark _peekN so it knows where to return.
# peek up/down (mod+Ctrl+=/-): opacity in 10% steps, 10-100%, shown on wob.
# The level is remembered for later peeks until logout.
STATE="$XDG_RUNTIME_DIR/peek-opacity"
WOB="$XDG_RUNTIME_DIR/wob.sock"
op=$(cat "$STATE" 2>/dev/null || echo 80)

case "$1" in
  up|down)
    swaymsg -t get_marks | grep -q '"_peek' || exit 0
    [ "$1" = up ] && op=$((op + 10)) || op=$((op - 10))
    [ "$op" -gt 100 ] && op=100
    [ "$op" -lt 10 ] && op=10
    echo "$op" > "$STATE"
    swaymsg "[con_mark=\"^_peek\"] opacity $(awk "BEGIN{print $op/100}")" >/dev/null
    [ -p "$WOB" ] && echo "$op" > "$WOB"
    exit 0 ;;
esac

# Send back a window that is already peeking. Prints its workspace number.
back() {
  pkill -f "^/bin/sh .*/peek watch$"
  old=$(swaymsg -t get_marks | jq -r '.[] | select(startswith("_peek"))' | head -n1)
  [ -z "$old" ] && return
  cur=$(swaymsg -t get_workspaces | jq -r '.[] | select(.focused) | .num')
  # Focus it on its home workspace, then come back, so that workspace's
  # last-focused window stays this one (next peek and mod+N pick it again).
  ret=""
  [ "$cur" != "${old#_peek}" ] && ret="; workspace number $cur"
  swaymsg "[con_mark=\"^$old\$\"] opacity 1, floating disable, move container to workspace number ${old#_peek}, unmark $old, focus$ret" >/dev/null
  swaymsg '[app_id="^peek-hold$"] kill' >/dev/null 2>&1
  echo "${old#_peek}"
}

case "$1" in
  # Wait for the next workspace switch, then send the window back.
  watch)
    # Act inside the loop: code after the pipe would wait for swaymsg to exit,
    # and swaymsg exits only when it fails to write the next event.
    swaymsg -t subscribe -m '["workspace"]' | while read -r ev; do
      printf '%s' "$ev" | jq -e '.change == "focus"' >/dev/null && exec "$0" end
    done
    exit 0 ;;
  end) back >/dev/null; exit 0 ;;
  # mod+N: on workspace N with a window peeking over it, send it back.
  go)
    cur=$(swaymsg -t get_workspaces | jq -r '.[] | select(.focused) | .num')
    [ "$cur" = "$2" ] && swaymsg -t get_marks | grep -q '"_peek' && { back >/dev/null; exit 0; }
    swaymsg "workspace number $2" >/dev/null; exit 0 ;;
esac

n=$1
[ "$(back)" = "$n" ] && exit 0

tree=$(swaymsg -t get_tree)
cur=$(swaymsg -t get_workspaces | jq -r '.[] | select(.focused) | .num')
[ "$cur" = "$n" ] && exit 0

# Follow the focus list from workspace N down to its last-focused window.
id=$(printf '%s' "$tree" | jq --argjson n "$n" '
  def leaf: if ((.nodes + .floating_nodes) | length) == 0 then .id
    else .focus[0] as $f | (.nodes + .floating_nodes)[] | select(.id == $f) | leaf end;
  first(.. | select(.type? == "workspace" and .num == $n) | leaf) // empty')
[ -z "$id" ] && exit 0
# Empty workspace: leaf returns the workspace itself.
printf '%s' "$tree" | jq -e --argjson id "$id" '.. | select(.id? == $id and .type == "workspace")' >/dev/null && exit 0

swaymsg "[con_id=$id] mark --add _peek$n, move container to workspace number $cur, floating enable, resize set width 100 ppt height 100 ppt, move position center, opacity $(awk "BEGIN{print $op/100}"), focus" >/dev/null
"$0" watch >/dev/null 2>&1 &

# Workspace N is now empty and gone. Put an invisible placeholder there so
# it stays in the bar while its window peeks.
foot -a peek-hold sleep infinity >/dev/null 2>&1 &
i=0
until swaymsg -t get_tree | jq -e '.. | select(.app_id? == "peek-hold")' >/dev/null; do
  i=$((i + 1)); [ "$i" -gt 40 ] && exit 0; sleep 0.05
done
swaymsg "[app_id=\"^peek-hold\$\"] move container to workspace number $n; [con_id=$id] focus" >/dev/null
