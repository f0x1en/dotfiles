#!/bin/sh
# mod+m: show or hide the music window. Music keeps playing while it is hidden.
# mod+Shift+m (arg restart): close it and open a fresh one, e.g. after a config change.
if [ "$1" = restart ]; then
  swaymsg '[title="^music$"] kill' >/dev/null
  while swaymsg -t get_tree | jq -e '.. | select(.name? == "music")' >/dev/null 2>&1; do sleep 0.1; done
fi
if swaymsg -t get_tree | jq -e '.. | select(.name? == "music")' >/dev/null 2>&1; then
  swaymsg '[title="^music$"] scratchpad show' >/dev/null
else
  exec kitty --title music rmpc
fi
