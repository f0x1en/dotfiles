# Muted Campbell
set default-bg "#0C0C0C"
set default-fg "#B8B8B8"

# Status and input bars
set statusbar-bg "#0C0C0C"
set statusbar-fg "#B8B8B8"
set inputbar-bg "#0C0C0C"
set inputbar-fg "#B8B8B8"

# PDF dark mode
set recolor-lightcolor "#0C0C0C"
set recolor-darkcolor "#B8B8B8"
set recolor true
set recolor-keephue true

# Toggle PDF recoloring
map <C-r> recolor

# Copy to system clipboard
set selection-clipboard clipboard
