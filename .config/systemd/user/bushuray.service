[Unit]
Conflicts=proxy-fallback.service
Description=Bushuray core: xray proxy, mixed SOCKS + HTTP on 127.0.0.1:10808, managed with the bushuray TUI

[Service]
WorkingDirectory=%h/.local/opt/bushuray
# subscriptions are fetched through the proxy itself
Environment=HTTPS_PROXY=http://127.0.0.1:10808 HTTP_PROXY=http://127.0.0.1:10808
ExecStart=%h/.local/opt/bushuray/bushuray-core
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
