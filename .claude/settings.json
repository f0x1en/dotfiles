{
  "env": {
    "HTTP_PROXY": "http://127.0.0.1:10808",
    "HTTPS_PROXY": "http://127.0.0.1:10808",
    "http_proxy": "http://127.0.0.1:10808",
    "https_proxy": "http://127.0.0.1:10808",
    "NO_PROXY": "localhost,127.0.0.1,::1",
    "no_proxy": "localhost,127.0.0.1,::1",
    "CLAUDE_CODE_HIDE_CWD": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(apt-cache *)",
      "Bash(bash -n *)",
      "Bash(command -v *)",
      "Bash(df*)",
      "Bash(dpkg -l*)",
      "Bash(dpkg-query *)",
      "Bash(du *)",
      "Bash(fd *)",
      "Bash(file *)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" add *)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" commit *)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" diff *)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" log *)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" push origin main)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" push)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" status *)",
      "Bash(git --git-dir=* --work-tree=* check-ignore*)",
      "Bash(git --git-dir=* --work-tree=* diff*)",
      "Bash(git --git-dir=* --work-tree=* log*)",
      "Bash(git --git-dir=* --work-tree=* ls-files*)",
      "Bash(git --git-dir=* --work-tree=* show*)",
      "Bash(git --git-dir=* --work-tree=* status*)",
      "Bash(git check-ignore*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git ls-files*)",
      "Bash(git show*)",
      "Bash(git status*)",
      "Bash(jq *)",
      "Bash(ls*)",
      "Bash(pwd)",
      "Bash(python3 -m py_compile *)",
      "Bash(rg *)",
      "Bash(rtk gain*)",
      "Bash(rtk git log*)",
      "Bash(rtk git status*)",
      "Bash(rtk ls*)",
      "Bash(sh -n *)",
      "Bash(stat *)",
      "Bash(sway -C*)",
      "Bash(swaymsg -t get_*)",
      "Bash(systemctl is-active*)",
      "Bash(systemctl is-enabled*)",
      "Bash(systemctl status*)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(zsh -n *)",
      "Edit(~/.claude/handoffs/**)",
      "Write(~/.claude/handoffs/**)"
    ],
    "deny": [
      "Bash(*.credentials.json*)",
      "Bash(*.git-credentials*)",
      "Bash(*.vault-token*)",
      "Bash(*.zshrc.local*)",
      "Bash(*/.config/git/credentials*)",
      "Bash(*/.gnupg/*)",
      "Bash(*/.hermes/*)",
      "Bash(*/.omniroute/*)",
      "Bash(*/.ssh/*)",
      "Bash(*notebook_secret*)",
      "Bash(env | *)",
      "Bash(env)",
      "Bash(export -p*)",
      "Bash(printenv*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/git/credentials)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.hermes/**)",
      "Read(~/.local/share/jupyter/notebook_secret)",
      "Read(~/.omniroute/**)",
      "Read(~/.ssh/**)",
      "Read(~/.vault-token)",
      "Read(~/.zshrc.local)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/turn-timer.sh start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/turn-timer.sh end"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "cc-plugin-agents-md@builtin": true,
    "cc-plugin-diff@builtin": true,
    "superpowers@anthropic-plugin-directory": false,
    "code-review-anthropics@anthropic-plugin-directory": true,
    "skill-creator@anthropic-plugin-directory": true,
    "code-simplifier@anthropic-plugin-directory": true,
    "playwright@anthropic-plugin-directory": false,
    "claude-md-management@anthropic-plugin-directory": true
  },
  "outputStyle": "Concise",
  "awaySummaryEnabled": false,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(git --git-dir=$HOME/.cfg --work-tree=$HOME add -A*)",
      "Bash(git --git-dir=$HOME/.cfg --work-tree=$HOME add .*)"
    ],
    "environment": [
      "**Machine**: personal Debian testing desktop (Sway, zsh, kitty, nvim). Single user. No org, no cloud, no CI.",
      "**Trusted repo**: dotfiles bare repo ~/.cfg with $HOME as work tree. Remote origin = github.com (user own repo). Pushing to origin is routine.",
      "**Other repos**: project repos under $HOME are the user own work; their configured remotes are trusted.",
      "**Secrets**: paths in permissions.deny (~/.ssh, ~/.gnupg, ~/.omniroute, ~/.hermes, ~/.zshrc.local, credential and token files). Never read, print, commit or send them.",
      "**Network**: all traffic goes through the local proxy 127.0.0.1:10808. Public paste or gist services are outside the trust boundary."
    ]
  }
}
