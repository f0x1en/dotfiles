{
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/turn-timer.sh start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/turn-timer.sh end"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(apt-cache *)",
      "Bash(bash -n *)",
      "Bash(command -v *)",
      "Bash(df*)",
      "Bash(dpkg -l*)",
      "Bash(dpkg-query *)",
      "Bash(du *)",
      "Bash(fd *)",
      "Bash(file *)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" add *)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" commit *)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" diff *)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" log *)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" push origin main)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" push)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" status *)",
      "Bash(git --git-dir=* --work-tree=* check-ignore*)",
      "Bash(git --git-dir=* --work-tree=* diff*)",
      "Bash(git --git-dir=* --work-tree=* log*)",
      "Bash(git --git-dir=* --work-tree=* ls-files*)",
      "Bash(git --git-dir=* --work-tree=* show*)",
      "Bash(git --git-dir=* --work-tree=* status*)",
      "Bash(git check-ignore*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git ls-files*)",
      "Bash(git show*)",
      "Bash(git status*)",
      "Bash(jq *)",
      "Bash(ls*)",
      "Bash(pwd)",
      "Bash(python3 -m py_compile *)",
      "Bash(rg *)",
      "Bash(rtk gain*)",
      "Bash(rtk git log*)",
      "Bash(rtk git status*)",
      "Bash(rtk ls*)",
      "Bash(sh -n *)",
      "Bash(stat *)",
      "Bash(sway -C*)",
      "Bash(swaymsg -t get_*)",
      "Bash(systemctl is-active*)",
      "Bash(systemctl is-enabled*)",
      "Bash(systemctl status*)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(zsh -n *)",
      "Edit(~/.claude/handoffs/**)",
      "Write(~/.claude/handoffs/**)"
    ],
    "deny": [
      "Bash(*.credentials.json*)",
      "Bash(*.zshrc.local*)",
      "Bash(*/.gnupg/*)",
      "Bash(*/.omniroute/*)",
      "Bash(*/.ssh/*)",
      "Bash(env | *)",
      "Bash(env)",
      "Bash(export -p*)",
      "Bash(printenv*)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.gnupg/**)",
      "Read(~/.omniroute/**)",
      "Read(~/.ssh/**)",
      "Read(~/.zshrc.local)"
    ]
  },
  "outputStyle": "Concise",
  "theme": "dark-ansi"
}
