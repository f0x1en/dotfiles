{
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/turn-timer.sh start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/turn-timer.sh end"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" add *)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" commit *)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" push)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" push origin main)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" status *)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" log *)",
      "Bash(git --git-dir=\"$HOME/.cfg\" --work-tree=\"$HOME\" diff *)"
    ]
  },
  "outputStyle": "Concise",
  "theme": "dark-ansi"
}
