#!/bin/sh
# pdfmd: PDF -> Markdown-ready text via pdftotext (poppler).
# pdftotext is used because it keeps Persian word order; pymupdf4llm and
# markitdown reverse RTL words. Output is plain paragraphs (no headings/tables).
# Bidi marks from pdftotext are kept: they place punctuation and numbers
# correctly. NFKC turns Arabic/Persian presentation-form
# glyphs back into normal letters.
# Broken font maps (glyphs extract as U+FFFD or U+06FF, common in Persian PDFs
# printed from a browser) are repaired automatically with pdf-fixmap.
# --ocr: re-OCR every page first with ocrmypdf, for scans with no text layer.
# Languages: $PDFMD_LANG (default fas+eng; fas alone reads Persian better but
# breaks English words).
set -eu

ocr=0
[ "${1:-}" = "--ocr" ] && { ocr=1; shift; }
if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    echo "Usage: pdfmd [--ocr] input.pdf [output.md]   (output '-' = stdout)" >&2
    exit 2
fi

in=$1
out=${2:-${1%.*}.md}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

if [ $ocr = 1 ]; then
    ocrmypdf -q -l "${PDFMD_LANG:-fas+eng}" --force-ocr --output-type pdf "$in" "$tmp/ocr.pdf"
    in=$tmp/ocr.pdf
fi

pdftotext -enc UTF-8 "$in" "$tmp/out.txt"
if grep -q "$(printf '\357\277\275\|\333\277')" "$tmp/out.txt"; then  # U+FFFD, U+06FF
    pdf-fixmap "$in" "$tmp/fixed.pdf"
    pdftotext -enc UTF-8 "$tmp/fixed.pdf" "$tmp/out.txt"
fi

python3 -I -c '
import re, sys, unicodedata
t = open(sys.argv[1], encoding="utf-8").read()
t = unicodedata.normalize("NFKC", t).replace("\f", "\n\n")
t = re.sub(r"\n{3,}", "\n\n", t).strip() + "\n"
bad = t.count("�")
if bad:
    print(f"pdfmd: {bad} unreadable glyphs (pdf-fixmap could not repair them). Try: pdfmd --ocr ...", file=sys.stderr)
if sys.argv[2] == "-":
    sys.stdout.write(t)
else:
    open(sys.argv[2], "w", encoding="utf-8").write(t)
' "$tmp/out.txt" "$out"
