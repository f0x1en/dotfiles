#!/usr/bin/env python3
"""sms: TUI for the phone's SMS over adb (built on phonectl).

j/k or Up/Down pick a chat, Enter writes a reply (Enter sends, Esc cancels), r reloads, q quits.
New chats with someone you never texted: phonectl send WHO TEXT.
"""
import curses, importlib.util, locale, os, subprocess, sys, textwrap, time
from importlib.machinery import SourceFileLoader
from pathlib import Path

_path = str(Path(__file__).resolve().with_name("phonectl"))
_spec = importlib.util.spec_from_loader("phonectl", SourceFileLoader("phonectl", _path))
p = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(p)

ERRORS = (subprocess.CalledProcessError, ValueError)  # adb gone, or Termux returned no JSON


def chats(msgs):
    """[(threadid, number, msgs oldest first)], newest chat first."""
    by = {}
    for m in sorted(msgs, key=lambda m: m["received"]):
        by.setdefault(m["threadid"], []).append(m)
    return sorted(((t, ms[-1]["number"], ms) for t, ms in by.items()),
                  key=lambda c: c[2][-1]["received"], reverse=True)


def load():
    # shortcut: only the last 1000 messages, raise -l if old chats go missing
    return chats(p.termux("termux-sms-list -l 1000 -t all") or [])


def put(scr, y, x, s, attr=0):
    try:
        scr.addnstr(y, x, s, max(0, scr.getmaxyx()[1] - x), attr)
    except curses.error:
        pass  # writing the bottom-right cell raises, the text is still drawn


def draw(scr, cs, sel, reply, status):
    scr.erase()
    H, W = scr.getmaxyx()
    L = min(24, W // 3)
    top = max(0, sel - (H - 2))
    for row, (t, num, ms) in enumerate(cs[top:top + H - 1]):
        put(scr, row, 0, p.name_of(num)[:L - 1].ljust(L - 1), curses.A_REVERSE if top + row == sel else 0)
    scr.vline(0, L, curses.ACS_VLINE, H - 1)
    x, w = L + 2, W - L - 3
    lines = []
    for m in cs[sel][2] if cs else []:
        head = f"{m['received'][5:16]} {'<' if m['type'] == 'inbox' else '>'} "
        body = [l for para in m["body"].splitlines() for l in textwrap.wrap(para, max(10, w - len(head)))]
        for j, l in enumerate(body or [""]):
            lines.append((head if j == 0 else " " * len(head)) + l)
    for row, l in enumerate(lines[-(H - 1):]):  # shortcut: newest lines only, no scroll back; phonectl thread WHO 200 for more
        put(scr, row, x, l)
    if reply is None:
        curses.curs_set(0)
        put(scr, H - 1, 0, status or "j/k chat  enter reply  r reload  q quit", curses.A_DIM)
    else:
        curses.curs_set(1)
        put(scr, H - 1, 0, f"to {p.name_of(cs[sel][1])}: {reply}")


def main(scr):
    cs, sel, reply, status = load(), 0, None, ""
    while True:
        draw(scr, cs, sel, reply, status)
        k = scr.get_wch()
        status = ""
        if reply is None:
            if k == "q":
                return
            elif k in ("j", curses.KEY_DOWN):
                sel = max(0, min(sel + 1, len(cs) - 1))
            elif k in ("k", curses.KEY_UP):
                sel = max(sel - 1, 0)
            elif k == "r":
                try:
                    cs, status = load(), "reloaded"
                    sel = min(sel, max(0, len(cs) - 1))
                except ERRORS:
                    status = "phone not reachable (USB, adb)"
            elif k in ("\n", curses.KEY_ENTER) and cs:
                reply = ""
        elif k == "\x1b":
            reply = None
        elif k in ("\n", curses.KEY_ENTER):
            if not reply.strip():
                reply = None
                continue
            t, num, _ = cs[sel]
            try:
                p.termux(f"termux-sms-send -n {p.quote(num)} {p.quote(reply)}")
            except ERRORS:
                status = "not sent: phone not reachable (USB, adb)"  # reply text stays in the box
                continue
            reply, status = None, f"sent to {p.name_of(num)}"
            time.sleep(1)  # the phone needs a moment to list the sent message
            try:
                cs = load()
                sel = next((i for i, c in enumerate(cs) if c[0] == t), 0)
            except ERRORS:
                pass
        elif k in (curses.KEY_BACKSPACE, "\x7f", "\b"):
            reply = reply[:-1]
        elif isinstance(k, str) and k.isprintable():
            reply += k


if __name__ == "__main__":
    if sys.argv[1:] == ["test"]:
        m = lambda t, r, n: {"threadid": t, "received": r, "number": n, "body": "x", "type": "inbox"}
        cs = chats([m(1, "2026-01-01", "a"), m(2, "2026-01-03", "b"), m(1, "2026-01-02", "a")])
        assert [c[0] for c in cs] == [2, 1] and [x["received"] for x in cs[1][2]] == ["2026-01-01", "2026-01-02"]
        sys.exit(print("ok"))
    if sys.argv[1:]:
        sys.exit(__doc__)
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.wrapper(main)
    except ERRORS:
        sys.exit("sms: phone not reachable (USB cable, USB debugging, adb)")
