#!/usr/bin/env python3
"""music: extras for mpd (player UI is rmpc on mod+Shift+m).

music shuffle           re-order the songs after the playing one, each folder spread out (empty queue: whole library)
music find              one search box (fuzzel) over every song's tags and filename; enter plays it
music next              play rmpc's selected songs now, after the playing one (rmpc P)
music keys              short searchable list of the rmpc keys (rmpc ?)
music delete            move the playing track to the trash (asks first), play the next one
music watch             pause when the output switches away from headphones/bluetooth/HDMI/USB
"""
import os, random, re, subprocess, sys

ROOT = os.path.expanduser("~/Music")  # same as music_directory in ~/.config/mpd/mpd.conf


def mpc(*args, stdin=None):
    return subprocess.run(["mpc", "-q", *args], input=stdin, capture_output=True, text=True, check=True).stdout


def smart_order(files):
    """Shuffle with no repeats. Each folder's tracks are spread evenly over the whole queue."""
    groups = {}
    for f in files:
        groups.setdefault(os.path.dirname(f), []).append(f)
    keyed = []
    for g in groups.values():
        random.shuffle(g)
        keyed += [((i + random.random()) / len(g), f) for i, f in enumerate(g)]
    return [f for _, f in sorted(keyed)]


def shuffle():
    """Re-order only the tracks after the playing one; history and the playing track stay.
    Nothing playing: re-order the whole queue (or the whole library if the queue is empty) and play."""
    mpc("random", "off")
    queue = [f for f in mpc("-f", "%file%", "playlist").split("\n") if f]
    cur = mpc("-f", "%position%", "current").strip()
    if cur:
        up = queue[int(cur):]
        if up:
            mpc("del", f"{int(cur) + 1}-{len(queue)}")
            mpc("add", stdin="\n".join(smart_order(up)) + "\n")
        return
    files = queue or [f for f in mpc("listall").split("\n") if f]
    mpc("clear")
    mpc("add", stdin="\n".join(smart_order(files)) + "\n")
    mpc("play")


def find():
    """Pick a song by anything you remember (tags or file name, any case), then play it now."""
    fmt = "\t".join(["%file%"] + [f"[%{t}%]" for t in ("title", "artist", "album", "albumartist", "genre", "date", "composer")])
    rows = [r.split("\t") for r in mpc("-f", fmt, "search", "filename", "").split("\n") if r]
    labels = []
    for f, *tags in rows:
        seen = [t for i, t in enumerate(tags) if t and t not in tags[:i]]
        labels.append("  ·  ".join(seen + [f]))
    pick = subprocess.run(["fuzzel", "--dmenu", "--index", "--width", "100", "--prompt", "Song: "],
                          input="\n".join(labels) + "\n", capture_output=True, text=True).stdout.strip()
    if not pick:
        return
    play_now([rows[int(pick)][0]])


def play_now(files):
    """Play files now: jump to one already queued, else put them after the playing song (or at the end) and play."""
    queue = [q for q in mpc("-f", "%file%", "playlist").split("\n") if q]
    if len(files) == 1 and files[0] in queue:
        mpc("play", str(queue.index(files[0]) + 1))
    elif mpc("-f", "%position%", "current").strip():
        for f in reversed(files):  # each insert goes right after the playing song
            mpc("insert", f)
        mpc("next")
    else:
        mpc("add", *files)
        mpc("play", str(len(queue) + 1))


def next_():
    """rmpc P: play the selected (or hovered) songs now; works on an empty queue too."""
    files = [f for f in os.environ.get("SELECTED_SONGS", "").splitlines() if f]
    if not files:
        raise SystemExit("no song selected")
    play_now(files)


KEYS = """\
Enter      play the song (queues its folder) / open folder
P          play this song next, now (queue stays)
a          add selected song or folder to the end of the queue
d          remove selected song from queue (Queue tab)
D          clear the whole queue (Queue tab)
F          find a song by any word
/          search the list on screen (n = next match)
p          pause / play
< >        previous / next song
f b        skip forward / back in the song
, .        volume down / up
S          shuffle the songs coming up
Ctrl+t     move the playing song to the trash (asks)
1 2        Queue tab / Folders tab
Up Down    move;   Left Right = back / open folder
Space      select several rows (then a or D)
z          repeat on/off
v          single on/off (on = stops after each song)
x          random on/off
q          stop music and close the window
F1         every rmpc key (long list)
Super+Shift+m   show / hide this window
Super+F7 F8 F9   previous / pause / next (anywhere)"""


def keys():
    subprocess.run(["fuzzel", "--dmenu", "--width", "62", "--lines", "12", "--prompt", "Keys: "],
                   input=KEYS + "\n", capture_output=True, text=True)


def delete():
    rel = mpc("-f", "%file%", "current").strip()
    if not rel:
        raise SystemExit("nothing is playing")
    ask = subprocess.run(["fuzzel", "--dmenu", "--prompt", f"Trash {os.path.basename(rel)}? "],
                         input="no\nyes\n", capture_output=True, text=True)
    if ask.stdout.strip() != "yes":
        return
    mpc("next")
    subprocess.run(["gio", "trash", os.path.join(ROOT, rel)], check=True)
    mpc("update")


def output_state():
    """(default sink, its active port), or None when pactl fails."""
    try:
        name = subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True, check=True).stdout.strip()
        out = subprocess.run(["pactl", "list", "sinks"], capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return None
    block = out.split("Name: " + name + "\n", 1)[-1].split("\nSink #", 1)[0]
    port = re.search(r"Active Port: (.*)", block)
    return name, port.group(1) if port else ""


def external_output_lost(prev, now):
    """True when the output changed away from an external device (bluetooth, wired headphones, HDMI, USB)."""
    if not prev or not now or prev == now:
        return False
    internal = prev[0].startswith("alsa_output.") and "speaker" in prev[1].lower()
    return not internal


def watch():
    """Pause when the audio output switches away from an external device. Otherwise it moves to the speakers."""
    cur = output_state()
    sub = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE, text=True)
    for line in sub.stdout:
        if " on sink " not in line and " on card " not in line and " on server" not in line:
            continue
        now = output_state()
        if external_output_lost(cur, now):
            subprocess.run(["mpc", "-q", "pause"])
        cur = now or cur
    raise SystemExit("pactl subscribe ended")


def main():
    cmd, args = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else ("", [])
    if cmd == "shuffle" and not args:
        shuffle()
    elif cmd == "find" and not args:
        find()
    elif cmd == "next" and not args:
        next_()
    elif cmd == "keys" and not args:
        keys()
    elif cmd == "delete" and not args:
        delete()
    elif cmd == "watch" and not args:
        watch()
    else:
        raise SystemExit(__doc__.strip())


if __name__ == "__main__":
    main()
