#!/bin/sh
# proxy             engine in use and a check of 127.0.0.1:10808
# proxy bushuray    switch to Bushuray (kept across reboots)
# proxy v2rayn      switch to v2rayN's last config (kept across reboots)
# proxy retry       try Bushuray, else back to v2rayN
# proxy watch       proxy-watch.service: while online, restart Bushuray after 3 failed checks,
#                   switch to v2rayN after 3 more, then retry Bushuray every 10 min

AUTO=$HOME/.local/state/proxy-auto # exists when watch, not the user, switched to v2rayN

ok() { # $1 = proxy URL
    curl -s -o /dev/null -m 10 --noproxy '' -x "${1:-socks5h://127.0.0.1:10808}" \
        -w '%{http_code}' https://www.gstatic.com/generate_204 | grep -q 204
}

engine() {
    if systemctl --user -q is-active bushuray; then echo bushuray
    elif systemctl --user -q is-active proxy-fallback; then echo v2rayn
    else echo none; fi
}

status() {
    echo "engine: $(engine)"
    for p in socks5h http; do
        if ok $p://127.0.0.1:10808; then echo "  ok   $p"; else echo "  FAIL $p"; fi
    done
}

use() { # $1 = bushuray | v2rayn
    on=bushuray off=proxy-fallback
    [ "$1" = v2rayn ] && on=proxy-fallback off=bushuray
    systemctl --user disable -q $off
    systemctl --user enable -q --now $on # Conflicts= stops the other one
    i=0
    while [ $i -lt 20 ] && ! ok; do sleep 1; i=$((i + 1)); done
}

retry() { use bushuray; ok || { use v2rayn; return 1; }; }

watch() {
    sleep 60 # at login the network is not up yet
    f=0 t=0  # failed checks on Bushuray, ticks on v2rayN
    while sleep 20; do
        nmcli -t -f STATE general | grep -qx 'connected\|connected (site only)' || { f=0; continue; }
        case $(engine) in
        bushuray)
            t=0
            if ok; then f=0; else f=$((f + 1)); fi
            [ $f = 3 ] && systemctl --user restart bushuray
            if [ $f = 6 ]; then
                f=0
                use v2rayn && touch "$AUTO"
                notify-send -a proxy -u critical "Proxy on v2rayN" "Bushuray failed after a restart. Retry every 10 min."
            fi ;;
        v2rayn)
            f=0
            [ -e "$AUTO" ] || continue
            t=$((t + 1))
            [ $t -ge 30 ] || continue
            t=0
            retry && rm -f "$AUTO" && notify-send -a proxy "Proxy back on Bushuray" ;;
        esac
    done
}

case "$1" in
"") status ;;
bushuray | v2rayn) rm -f "$AUTO"; use "$1"; status ;;
retry) rm -f "$AUTO"; retry; status ;;
watch) watch ;;
*) sed -n '2,7p' "$0" | cut -c3-; exit 2 ;;
esac
