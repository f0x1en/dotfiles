#!/bin/sh
# proxy-up: start the proxy (127.0.0.1:10808) without the v2rayN GUI, e.g. on a text console.
# Runs v2rayN's xray core with the last config v2rayN wrote. `proxy-up stop` ends it
# (do that before starting Sway, or v2rayN's own core cannot take the port).
DIR="$HOME/.local/share/v2rayN"
if [ "$1" = stop ]; then
    pkill -f "$DIR/bin/xray/xray run -c config.json" && echo "proxy stopped"
    exit
fi
if ss -ltn | grep -q ':10808 '; then
    echo "proxy already up on 127.0.0.1:10808"
    exit
fi
cd "$DIR/binConfigs" || exit 1
setsid "$DIR/bin/xray/xray" run -c config.json >"$DIR/proxy-up.log" 2>&1 &
sleep 2
if ss -ltn | grep -q ':10808 '; then
    echo "proxy up on 127.0.0.1:10808"
else
    echo "proxy failed, see $DIR/proxy-up.log"
    exit 1
fi
