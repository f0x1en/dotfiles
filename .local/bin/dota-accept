#!/usr/bin/python3 -I
"""dota-accept: accept every Dota 2 match popup until the match really starts.

  dota-accept          toggle: arm if off, disarm if armed (also: click the bar icon)
  dota-accept on|off|status
  dota-accept bar      JSON for the waybar module (shown only while Dota runs)
  dota-accept --test FILE.png [SCALE...]   run the detector on a screenshot

While armed:
- If Dota's window turns urgent (match found while you are elsewhere), switch to it.
- While Dota is visible, grab its whole window 4 times a second (grim) and look
  for the ACCEPT button: normalized correlation against a cut-out of the real
  one, tried at the window's scale (fullscreen, tiled or floating, any size).
- On a hit: click it with sway's seat cursor, check the button is gone (clicks
  again, up to 5 times, if not), notify, save the frame to ~/.local/state/dota-accept/.
- Stays armed after accepting: if someone declines you are back in queue and the
  next popup is accepted too. Disarms when the match starts (hero selection,
  reported by Dota's Game State Integration on 127.0.0.1:3291; needs the Dota
  launch option -gamestateintegration), when Dota exits, or on `dota-accept off`.

Never reads or touches the game: screenshots in, mouse clicks out.
"""
import io, json, os, subprocess, sys, threading, time
from http.server import BaseHTTPRequestHandler, HTTPServer
import numpy as np
from numpy.lib.stride_tricks import sliding_window_view
from PIL import Image

STATE = os.path.expanduser("~/.local/state/dota-accept")
TEMPLATE = os.path.expanduser("~/.local/share/dota-accept/accept.png")  # cut from a 1920x1080 screenshot
MATCH = 0.8               # correlation needed to click
POLL = 0.25               # seconds between checks while armed
GSI_PORT = 3291


def sh(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def z(x):
    return (x - x.mean()) / (x.std() + 1e-6)


def find_button(img, scales=(1.0,)):
    """Return (x, y) of the ACCEPT button center inside img, or None.

    Compares against a cut-out of the real button (TEMPLATE) with normalized
    correlation, so brightness and the popup's glow do not matter. Real popups
    score 0.98-1.0; menus, game and desktop frames scored well under MATCH.
    Dota shrinks its UI with its window, so the cut-out is tried at each scale.
    """
    a = np.asarray(img.convert("L"), dtype=np.float32)
    base = Image.open(TEMPLATE).convert("L")
    best = None
    for sc in sorted(set(round(x, 2) for x in scales)):
        t = base if sc == 1 else base.resize((max(8, round(base.width * sc)),
                                             max(4, round(base.height * sc))), Image.LANCZOS)
        hit = match(a, np.asarray(t, dtype=np.float32))
        if hit and (best is None or hit[0] > best[0]):
            best = hit
    return best[1:] if best and best[0] >= MATCH else None


def match(a, tpl):
    """(score, center x, center y) of the best spot for tpl in a, or None."""
    th, tw = tpl.shape
    if a.shape[0] < th or a.shape[1] < tw:
        return None
    # Rough pass on every step-th pixel; keep the 3 best spots.
    step = 8 if th >= 40 else 4 if th >= 16 else 2
    ts = tpl[::step, ::step]
    win = sliding_window_view(a[::step, ::step], ts.shape)
    wz = (win - win.mean(axis=(2, 3), keepdims=True)) / (win.std(axis=(2, 3), keepdims=True) + 1e-6)
    c = (wz * z(ts)).mean(axis=(2, 3))
    tz, best = z(tpl), None
    for i in np.argsort(c, axis=None)[-3:]:
        y, x = (v * step for v in np.unravel_index(i, c.shape))
        # Full-resolution check around that spot.
        for dy in range(-step, step + 1):
            for dx in range(-step, step + 1):
                yy, xx = y + dy, x + dx
                if 0 <= yy <= a.shape[0] - th and 0 <= xx <= a.shape[1] - tw:
                    sc = float((z(a[yy:yy + th, xx:xx + tw]) * tz).mean())
                    if best is None or sc > best[0]:
                        best = (sc, xx + tw // 2, yy + th // 2)
    return best


def dota_window(tree):
    stack = [tree]
    while stack:
        n = stack.pop()
        if (n.get("window_properties") or {}).get("class") == "dota2":
            return n
        stack += n.get("nodes", []) + n.get("floating_nodes", [])
    return None


def visible(tree, win):
    ws = json.loads(sh("swaymsg", "-t", "get_workspaces"))
    shown = {w["name"] for w in ws if w["visible"]}
    def walk(n, wsname):
        if n.get("type") == "workspace":
            wsname = n["name"]
        if n.get("id") == win["id"]:
            return wsname in shown
        return any(walk(c, wsname) for c in n.get("nodes", []) + n.get("floating_nodes", []))
    return walk(tree, None)


def tick():
    """One check. Returns True after an accepted popup (button gone)."""
    tree = json.loads(sh("swaymsg", "-t", "get_tree"))
    win = dota_window(tree)
    if not win:
        return False
    if not visible(tree, win):
        if not win.get("urgent"):
            return False
        sh("swaymsg", f"[con_id={win['id']}] focus")
        time.sleep(0.5)
        win = dota_window(json.loads(sh("swaymsg", "-t", "get_tree"))) or win
    # Dota's picture on screen: container rect plus the window's offset in it.
    # Dota fits its 1920x1080 UI by height or by width.
    r, wr = win["rect"], win["window_rect"]
    x0, y0, w, h = r["x"] + wr["x"], r["y"] + wr["y"], wr["width"], wr["height"]
    scales = [b * k for b in (h / 1080, w / 1920) for k in (0.95, 0.975, 1.0, 1.025, 1.05)]

    def grab():
        png = subprocess.run(["grim", "-g", f"{x0},{y0} {w}x{h}", "-"], capture_output=True).stdout
        if not png:
            return None, None
        img = Image.open(io.BytesIO(png))
        return img, find_button(img, scales)

    img, hit = grab()
    if not hit:
        return False
    os.makedirs(STATE, exist_ok=True)
    img.save(os.path.join(STATE, "last-click.png"))
    # Click, then confirm the button is gone; a click during the popup's
    # fade-in can be dropped, so retry while ACCEPT is still on screen.
    for attempt in range(1, 6):
        cx, cy = x0 + hit[0], y0 + hit[1]
        sh("swaymsg", f"seat seat0 cursor set {cx} {cy}")
        time.sleep(0.1)  # let the game see the hover first
        sh("swaymsg", "seat seat0 cursor press button1")
        time.sleep(0.05)
        sh("swaymsg", "seat seat0 cursor release button1")
        with open(os.path.join(STATE, "log"), "a") as f:
            f.write(f"{time.strftime('%F %T')} click {attempt} at {cx},{cy}\n")
        time.sleep(0.7)
        _, again = grab()
        if not again:
            return True
        hit = again
    return False  # still showing after 5 clicks; stay armed and keep trying


def gsi(started):
    """Listen for Dota's Game State Integration; set `started` once a match runs."""
    class H(BaseHTTPRequestHandler):
        def do_POST(self):
            body = self.rfile.read(int(self.headers.get("Content-Length", 0)))
            self.send_response(200); self.end_headers()
            try:
                state = (json.loads(body).get("map") or {}).get("game_state", "")
            except ValueError:
                return
            if state and state != "DOTA_GAMERULES_STATE_INIT":
                started.set()

        def log_message(self, *a):
            pass
    try:
        HTTPServer(("127.0.0.1", GSI_PORT), H).serve_forever()
    except OSError as e:
        print("dota-accept: GSI listener:", e, file=sys.stderr)


def notify(msg):
    sh("notify-send", "-a", "dota-accept", "Dota auto-accept", msg)
    subprocess.run(["pkill", "-RTMIN+9", "-x", "waybar"])


def running():
    return subprocess.run(["pgrep", "-f", "dota-accept run$"], capture_output=True).returncode == 0


def dota_running():
    return subprocess.run(["pgrep", "-x", "dota2"], capture_output=True).returncode == 0


def run():
    started = threading.Event()
    threading.Thread(target=gsi, args=(started,), daemon=True).start()
    accepted = 0
    while True:
        if not dota_running():
            notify("Dota closed: disarmed")
            return
        if started.is_set():
            notify("Match started: disarmed")
            return
        try:
            if tick():
                accepted += 1
                notify(f"Accepted (popup {accepted}). Stays armed until the match starts.")
        except Exception as e:  # keep running; sway may be mid-reload
            print("dota-accept:", e, file=sys.stderr)
        time.sleep(POLL)


def arm():
    if running():
        print("already armed"); return
    if not dota_running():
        print("Dota is not running"); sys.exit(1)
    os.makedirs(STATE, exist_ok=True)
    log = open(os.path.join(STATE, "err.log"), "a")
    subprocess.Popen([os.path.abspath(sys.argv[0]), "run"], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=log, stderr=log)
    print("armed: accepts every popup until the match starts"); notify("Armed")


def disarm():
    if subprocess.run(["pkill", "-f", "dota-accept run$"]).returncode == 0:
        print("disarmed"); notify("Disarmed")
    else:
        print("was not armed")


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    if arg == "--test":
        print(find_button(Image.open(sys.argv[2]), [float(x) for x in sys.argv[3:]] or [1.0]))
    elif arg == "run":
        run()
    elif arg == "toggle":
        disarm() if running() else arm()
    elif arg == "on":
        arm()
    elif arg == "off":
        disarm()
    elif arg == "status":
        print("armed" if running() else "off")
    elif arg == "bar":
        if not dota_running():
            print(json.dumps({"text": ""}))
        elif running():
            print(json.dumps({"text": "\uf11b accept", "class": "armed", "tooltip": "Dota auto-accept: armed (click to disarm)"}))
        else:
            print(json.dumps({"text": "\uf11b", "class": "off", "tooltip": "Dota auto-accept: off (click to arm)"}))
    else:
        print(__doc__); sys.exit(2)


if __name__ == "__main__":
    main()
