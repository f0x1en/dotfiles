#!/usr/bin/python3 -I
"""dota-accept: click Dota 2's green ACCEPT button once, when a match is found.

  dota-accept          arm it in the background (run it when you start searching)
  dota-accept off      disarm
  dota-accept status   armed or not
  dota-accept --test FILE.png   run the detector on a screenshot

While armed: if Dota's window turns urgent (match found while you are
elsewhere), switch to it and make it fullscreen. While Dota is visible, grab the
middle of the screen once a second (grim) and look for the ACCEPT
button that matches a cut-out of the real one. On a hit: click it with sway's seat
cursor, notify, save the frame to ~/.local/state/dota-accept/, and disarm.
Also disarms when Dota exits.

Never reads or touches the game: screenshots in, one mouse click out.
"""
import io, json, os, subprocess, sys, time
import numpy as np
from numpy.lib.stride_tricks import sliding_window_view
from PIL import Image

STATE = os.path.expanduser("~/.local/state/dota-accept")
REGION = (900, 560)       # width, height of the scanned box around the screen center
TEMPLATE = os.path.expanduser("~/.local/share/dota-accept/accept.png")  # cut from a 1920x1080 screenshot
MATCH = 0.8               # correlation needed to click


def sh(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def z(x):
    return (x - x.mean()) / (x.std() + 1e-6)


def find_button(img):
    """Return (x, y) of the ACCEPT button center inside img, or None.

    Compares against a cut-out of the real button (TEMPLATE) with normalized
    correlation, so brightness and the popup's glow do not matter. Real popups
    score 0.98-1.0; menus, game and desktop frames scored 0.44 or less.
    """
    tpl = np.asarray(Image.open(TEMPLATE).convert("L"), dtype=np.float32)
    a = np.asarray(img.convert("L"), dtype=np.float32)
    if a.shape[0] < tpl.shape[0] or a.shape[1] < tpl.shape[1]:
        return None
    # Coarse pass on every 4th pixel, then refine around the best spot.
    t4 = tpl[::4, ::4]
    w = sliding_window_view(a[::4, ::4], t4.shape)
    wz = (w - w.mean(axis=(2, 3), keepdims=True)) / (w.std(axis=(2, 3), keepdims=True) + 1e-6)
    c = (wz * z(t4)).mean(axis=(2, 3))
    y, x = (v * 4 for v in np.unravel_index(c.argmax(), c.shape))
    tz, best = z(tpl), (-1.0, 0, 0)
    for dy in range(-4, 5):
        for dx in range(-4, 5):
            yy, xx = y + dy, x + dx
            if 0 <= yy <= a.shape[0] - tpl.shape[0] and 0 <= xx <= a.shape[1] - tpl.shape[1]:
                s = float((z(a[yy:yy + tpl.shape[0], xx:xx + tpl.shape[1]]) * tz).mean())
                best = max(best, (s, xx, yy))
    if best[0] < MATCH:
        return None
    return best[1] + tpl.shape[1] // 2, best[2] + tpl.shape[0] // 2


def dota_window(tree):
    stack = [tree]
    while stack:
        n = stack.pop()
        if (n.get("window_properties") or {}).get("class") == "dota2":
            return n
        stack += n.get("nodes", []) + n.get("floating_nodes", [])
    return None


def visible(tree, win):
    ws = json.loads(sh("swaymsg", "-t", "get_workspaces"))
    shown = {w["name"] for w in ws if w["visible"]}
    def walk(n, wsname):
        if n.get("type") == "workspace":
            wsname = n["name"]
        if n.get("id") == win["id"]:
            return wsname in shown
        return any(walk(c, wsname) for c in n.get("nodes", []) + n.get("floating_nodes", []))
    return walk(tree, None)


def tick():
    """One check. Returns True after a click."""
    tree = json.loads(sh("swaymsg", "-t", "get_tree"))
    win = dota_window(tree)
    if not win:
        return False
    if not visible(tree, win):
        if not win.get("urgent"):
            return False
        sh("swaymsg", f"[con_id={win['id']}] focus, fullscreen enable")
        time.sleep(0.7)
    out = next(o for o in json.loads(sh("swaymsg", "-t", "get_outputs")) if o["focused"])
    r = out["rect"]
    w, h = min(REGION[0], r["width"]), min(REGION[1], r["height"])
    x0, y0 = r["x"] + (r["width"] - w) // 2, r["y"] + (r["height"] - h) // 2
    png = subprocess.run(["grim", "-g", f"{x0},{y0} {w}x{h}", "-"], capture_output=True).stdout
    if not png:
        return False
    img = Image.open(io.BytesIO(png))
    hit = find_button(img)
    if not hit:
        return False
    sh("swaymsg", f"[con_id={win['id']}] fullscreen enable")
    cx, cy = x0 + hit[0], y0 + hit[1]
    sh("swaymsg", f"seat seat0 cursor set {cx} {cy}")
    sh("swaymsg", "seat seat0 cursor press button1")
    time.sleep(0.05)
    sh("swaymsg", "seat seat0 cursor release button1")
    os.makedirs(STATE, exist_ok=True)
    img.save(os.path.join(STATE, "last-click.png"))
    with open(os.path.join(STATE, "log"), "a") as f:
        f.write(f"{time.strftime('%F %T')} clicked {cx},{cy}\n")
    return True


def notify(msg):
    sh("notify-send", "-a", "dota-accept", "Dota auto-accept", msg)


def running():
    return subprocess.run(["pgrep", "-f", "dota-accept run$"], capture_output=True).returncode == 0


def run():
    while True:
        if subprocess.run(["pgrep", "-x", "dota2"], capture_output=True).returncode:
            notify("Dota closed: disarmed")
            return
        try:
            if tick():
                notify("Match accepted: disarmed")
                return
        except Exception as e:  # keep running; sway may be mid-reload
            print("dota-accept:", e, file=sys.stderr)
        time.sleep(1)


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "on"
    if arg == "--test":
        print(find_button(Image.open(sys.argv[2])))
    elif arg == "run":
        run()
    elif arg == "off":
        if subprocess.run(["pkill", "-f", "dota-accept run$"]).returncode == 0:
            print("disarmed"); notify("Disarmed")
        else:
            print("was not armed")
    elif arg == "status":
        print("armed" if running() else "off")
    elif arg == "on":
        if running():
            print("already armed"); return
        if subprocess.run(["pgrep", "-x", "dota2"], capture_output=True).returncode:
            print("Dota is not running"); sys.exit(1)
        os.makedirs(STATE, exist_ok=True)
        log = open(os.path.join(STATE, "err.log"), "a")
        subprocess.Popen([os.path.abspath(sys.argv[0]), "run"], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log)
        print("armed: switches to Dota and accepts when the match pops"); notify("Armed")
    else:
        print(__doc__); sys.exit(2)


if __name__ == "__main__":
    main()
