#!/usr/bin/env python3
"""phonectl: SMS and calls of the USB-connected Android phone, over adb only (no app on the phone).

phonectl sms [N]             last N messages, newest last (default 20)
phonectl thread WHO [N]      last N messages with one contact or number
phonectl send WHO TEXT...    send an SMS
phonectl call WHO            dial
phonectl answer              pick up the ringing call
phonectl hangup              end or decline the call
phonectl contacts            list phone and SIM contacts
phonectl add-contact NAME NUMBER   new contact in phone storage
phonectl edit-contact WHO NAME NUMBER   change name and number (phone or SIM contact)
phonectl del-contact WHO     delete (phone storage only; SIM: use the phone's Contacts app)
phonectl calls [N]           last N calls, newest last (default 20)
phonectl sim                 SIM slots: carrier, state, network, signal, default for sms/voice/data
phonectl watch               desktop notification for new SMS and incoming calls (runs as phone-watch.service)

WHO is a number or part of a contact name.
"""
import re, subprocess, sys, threading, time


def adb(*args, check=True):
    return subprocess.run(["adb", "shell", *args], capture_output=True, text=True, check=check).stdout


def query(uri, projection, where=None, sort=None):
    """Rows of an Android content provider as dicts. The last column may hold commas and newlines."""
    cmd = f"content query --uri {uri} --projection {projection}"
    if where:
        cmd += f" --where {quote(where)}"
    if sort:
        cmd += f" --sort {quote(sort)}"
    cols = projection.split(":")
    row = re.compile(", ".join([f"{c}=(.*?)" for c in cols[:-1]] + [f"{cols[-1]}=(.*)"]), re.S)
    return [dict(zip(cols, m.groups())) for r in re.split(r"(?m)^Row: \d+ ", adb(cmd))[1:]
            if (m := row.match(r.rstrip("\n")))]


def messages(n, where=None):
    """Last N SMS, in the shape show() and the sms TUI use."""
    return [{"threadid": int(r["thread_id"]), "number": r["address"], "body": r["body"],
             "received": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(int(r["date"]) / 1000)),
             "type": "inbox" if r["type"] == "1" else "sent"}
            for r in query("content://sms", "_id:thread_id:address:date:type:body", where, f"date DESC LIMIT {int(n)}")]


def send_sms(number, text):
    """Send through the phone's own SMS service as the adb shell user, which holds SEND_SMS."""
    # shortcut: one SMS part only; longer text needs ISms.sendMultipartTextForSubscriber
    limit = 160 if text.isascii() and not set(text) & set("[]{}\\^~|`") else 70
    if len(text) > limit:
        raise ValueError(f"text is {len(text)} chars, one SMS holds {limit}")
    sub = re.search(r"defaultSmsSubId=(\d+)", adb("dumpsys isub"))[1]
    # Android 13 ISms transaction 5 = sendTextForSubscriber(subId, pkg, attributionTag, dest, scAddr, text,
    # sentIntent, deliveryIntent, persist, messageId). Null string = i32 -1, null intent = i32 0.
    # persist=1 stores it in Sent, as the shell is not the default SMS app.
    out = adb(f"service call isms 5 i32 {sub} s16 com.android.shell i32 -1 s16 {quote(number)} i32 -1 "
              f"s16 {quote(text)} i32 0 i32 0 i32 1 i64 0")
    if "Parcel(00000000" not in out:
        raise RuntimeError(f"isms refused: {out.strip()}")


def quote(s):
    return "'" + s.replace("'", "'\\''") + "'"


def digits(n):
    return re.sub(r"\D", "", n or "")[-10:]


_contacts = None


def contacts():
    global _contacts
    if _contacts is None:
        # src: "phone" (phone storage, full edit), "sim", or the app that syncs it (read-only here)
        _contacts = [{"name": r["display_name"], "number": r["data1"], "id": r["raw_contact_id"],
                      "src": "phone" if r["account_type"] in ("NULL", "vnd.sec.contact.phone") else r["account_type"].split(".")[-1]}
                     for r in query("content://com.android.contacts/data/phones", "raw_contact_id:account_type:display_name:data1")]
        # SIM contacts are not in data/phones; icc/adn ignores --projection, so match up to emails
        _contacts += [{"name": r["name"], "number": r["number"], "src": "sim"}
                      for r in query("content://icc/adn", "name:number:emails") if r["number"]]
    return _contacts


def name_of(number):
    d = digits(number)
    for c in contacts():
        if d and digits(c["number"]) == d:
            return c["name"]
    return number


def resolve(who):
    """Number as given, or the number of the one contact whose name contains WHO."""
    if re.fullmatch(r"[+\d][\d\s-]*", who):
        return re.sub(r"[\s-]", "", who)
    hits = {c["number"]: c["name"] for c in contacts() if who.lower() in c["name"].lower()}
    if len(hits) != 1:
        sys.exit(f"phonectl: '{who}' matches {len(hits)} contacts: " + ", ".join(f"{v} {k}" for k, v in hits.items()))
    return next(iter(hits))


def show(msgs):
    for m in sorted(msgs, key=lambda m: m["received"]):
        arrow = "<" if m["type"] == "inbox" else ">"
        print(f"{m['received'][:16]} {arrow} {name_of(m['number'])}: {m['body']}")


def sms(n=20):
    show(messages(n))


def thread(who, n=20):
    number = resolve(who)
    d = digits(number)  # empty for a sender name like a bank's: then match it exactly
    show(messages(n, f"address LIKE '%{d}'" if d else "address = '" + number.replace("'", "''") + "'"))


def send(who, *text):
    if not text:
        sys.exit("phonectl: no text")
    number = resolve(who)
    try:
        send_sms(number, " ".join(text))
    except (ValueError, RuntimeError) as e:
        sys.exit(f"phonectl: not sent: {e}")
    print(f"sent to {name_of(number)} ({number})")


def dial(number):
    adb("am", "start", "-a", "android.intent.action.CALL", "-d", f"tel:{number}")


def call(who):
    number = resolve(who)
    dial(number)
    print(f"calling {name_of(number)} ({number})")


KINDS = {"1": "in", "2": "out", "3": "missed", "4": "voicemail", "5": "rejected", "6": "blocked"}


def call_log(n):
    """Last N calls, newest first."""
    return [{"when": time.strftime("%Y-%m-%d %H:%M", time.localtime(int(r["date"]) / 1000)),
             "secs": int(r["duration"]), "kind": KINDS.get(r["type"], r["type"]), "number": r["number"]}
            for r in query("content://call_log/calls", "date:duration:type:number", None, f"date DESC LIMIT {int(n)}")]


def calls(n=20):
    for c in reversed(call_log(n)):
        print(f"{c['when']} {c['kind']:<8} {c['secs'] // 60:>3}m{c['secs'] % 60:02}s {name_of(c['number'])}")


def add_contact(name, number):
    """New contact in phone storage (not the SIM, not an account)."""
    global _contacts
    adb("content insert --uri content://com.android.contacts/raw_contacts --bind account_type:n: --bind account_name:n:")
    rid = query("content://com.android.contacts/raw_contacts", "_id", None, "_id DESC LIMIT 1")[0]["_id"]
    for mime, value in (("name", name), ("phone_v2", number)):
        adb(f"content insert --uri content://com.android.contacts/data --bind raw_contact_id:i:{int(rid)} "
            f"--bind mimetype:s:vnd.android.cursor.item/{mime} --bind data1:s:{quote(value)}"
            + (" --bind data2:i:2" if mime == "phone_v2" else ""))  # data2=2: mobile
    _contacts = None


def contact(who):
    """The one contact whose name contains WHO or whose number matches it."""
    d = digits(who)
    hits = [c for c in contacts() if who.lower() in c["name"].lower() or (d and digits(c["number"]) == d)]
    if len(hits) != 1:
        sys.exit(f"phonectl: '{who}' matches {len(hits)} contacts: " + ", ".join(f"{c['name']} {c['number']}" for c in hits))
    return hits[0]


def edit_contact(c, name, number):
    global _contacts
    if c["src"] == "sim":
        adb(f"content update --uri content://icc/adn --bind tag:s:{quote(c['name'])} --bind number:s:{quote(c['number'])} "
            f"--bind newTag:s:{quote(name)} --bind newNumber:s:{quote(number)}")
        # Samsung's IccProvider reports success even when it writes nothing, so check
        if not any(r["name"] == name and r["number"] == number for r in query("content://icc/adn", "name:number:emails")):
            raise RuntimeError("the SIM refused the change; edit it in the phone's Contacts app")
    elif c["src"] == "phone":
        rid, old = int(c["id"]), c["number"].replace("'", "''")
        # clear the split name parts, or the provider keeps showing the old name
        adb(f"content update --uri content://com.android.contacts/data --bind data1:s:{quote(name)} "
            + " ".join(f"--bind data{i}:n:" for i in range(2, 7))
            + " --where " + quote(f"raw_contact_id={rid} AND mimetype='vnd.android.cursor.item/name'"))
        adb(f"content update --uri content://com.android.contacts/data --bind data1:s:{quote(number)} "
            + " --where " + quote(f"raw_contact_id={rid} AND data1='{old}'"))
    else:
        raise RuntimeError(f"synced by {c['src']}, edit it there")
    _contacts = None


def delete_contact(c):
    global _contacts
    if c["src"] == "sim":
        # Samsung's IccProvider ignores every --where form tried (tag/number, index, efid); SIM delete needs its Contacts app
        raise RuntimeError("SIM contacts can only be deleted in the phone's Contacts app")
    if c["src"] != "phone":
        raise RuntimeError(f"synced by {c['src']}, delete it there")
    adb(f"content delete --uri {quote('content://com.android.contacts/raw_contacts?caller_is_syncadapter=true')} "
        f"--where {quote('_id=' + str(int(c['id'])))}")
    _contacts = None


def sims():
    """One dict per SIM slot: sub id, carrier, state, network, LTE/5G signal, default roles."""
    isub = adb("dumpsys isub")
    slot_sub = {int(slot): sub for sub, slot in re.findall(r"\{id=(\d+) iccId=\S+ simSlotIndex=(\d+)", isub)}
    roles = {role: re.search(rf"default{role.title()}SubId=(\d+)", isub) for role in ("sms", "voice", "data")}
    prop = lambda k: adb("getprop", k).strip().split(",")
    carrier, state, net = prop("gsm.operator.alpha"), prop("gsm.sim.state"), prop("gsm.network.type")
    # shortcut: one mSignalStrength line per slot, in slot order; LTE/NR only, other tech shows "?"
    sig = [re.search(r"(?:ss)?[rR]srp=(-\d+)", l) for l in re.findall(r"mSignalStrength=.*", adb("dumpsys telephony.registry"))]
    pick = lambda xs, i: xs[i] if i < len(xs) else "?"
    return [{"slot": i, "sub": sub, "carrier": pick(carrier, i), "state": pick(state, i), "net": pick(net, i),
             "dbm": (s[1] if (s := pick(sig, i)) and s != "?" else "?"),
             "roles": [r for r, m in roles.items() if m and m[1] == sub]}
            for i, sub in sorted(slot_sub.items())]


def sim():
    for s in sims():
        print(f"SIM {s['slot'] + 1} (sub {s['sub']}): {s['carrier']} {s['state']} {s['net']} {s['dbm']} dBm"
              f"  default for: {', '.join(s['roles']) or '-'}")


def notify(title, body, actions=()):
    """Desktop notification. With actions, returns the clicked action name (blocks until click or close)."""
    args = ["notify-send", "-a", "phone", title, body] + [f"--action={a}={a.title()}" for a in actions]
    if actions:
        args += ["-u", "critical"]
    return subprocess.run(args, capture_output=True, text=True).stdout.strip()


def new_sms(after):
    out = adb("content", "query", "--uri", "content://sms/inbox", "--projection", "_id:address:body",
              "--where", f"_id\\>{after}", "--sort", "'_id ASC'")
    for row in re.split(r"(?m)^Row: \d+ ", out)[1:]:
        m = re.match(r"_id=(\d+), address=(.*?), body=(.*)", row, re.S)
        if m:
            yield int(m[1]), m[2], m[3].strip()


def call_state():
    out = adb("dumpsys", "telephony.registry")
    state = re.search(r"mCallState=(\d)", out)
    number = re.search(r"mCallIncomingNumber=(\S*)", out)
    return (int(state[1]) if state else 0), (number[1] if number else "")


def on_ring(number):
    who = name_of(number) if number else "unknown number"
    act = notify("Incoming call", who, actions=("answer", "hangup"))
    if act == "answer":
        adb("input", "keyevent", "KEYCODE_CALL")
    elif act == "hangup":
        adb("input", "keyevent", "KEYCODE_ENDCALL")


def watch():
    last, ringing = None, False
    while True:
        try:
            subprocess.run(["adb", "wait-for-device"], check=True)
            if last is None:
                top = adb("content", "query", "--uri", "content://sms/inbox", "--projection", "_id",
                          "--sort", "'_id DESC LIMIT 1'")
                last = int(re.search(r"_id=(\d+)", top)[1]) if "_id=" in top else 0
            for i, addr, body in new_sms(last):
                notify(f"SMS {name_of(addr)}", body)
                last = i
            state, number = call_state()
            if state == 1 and not ringing:
                threading.Thread(target=on_ring, args=(number,), daemon=True).start()
            ringing = state == 1
        except subprocess.CalledProcessError:
            pass  # cable pulled mid-poll: wait-for-device catches it next round
        time.sleep(2)


CMDS = {"sms": sms, "thread": thread, "send": send, "call": call, "watch": watch,
        "answer": lambda: adb("input", "keyevent", "KEYCODE_CALL"),
        "hangup": lambda: adb("input", "keyevent", "KEYCODE_ENDCALL"),
        "contacts": lambda: [print(f"{c['name']}: {c['number']}") for c in contacts()],
        "calls": calls, "sim": sim, "add-contact": lambda name, number: add_contact(name, number),
        "edit-contact": lambda who, name, number: edit_contact(contact(who), name, number),
        "del-contact": lambda who: delete_contact(contact(who))}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        sys.exit(__doc__)
    try:
        CMDS[sys.argv[1]](*sys.argv[2:])
    except TypeError:
        sys.exit(__doc__)
    except RuntimeError as e:
        sys.exit(f"phonectl: {e}")
